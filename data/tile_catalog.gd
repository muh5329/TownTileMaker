func get_tile_ids() -> Array[String]:
	return TILE_MAP.keys()

func get_tile(id: String) -> Dictionary:
	return TILE_MAP[id]

func get_all_tiles() -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	for key in TILE_MAP.keys():
		entries.append(TILE_MAP[key])
	return entries

func get_card_entries() -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	for tile_id in get_tile_ids():
		entries.append(get_tile(tile_id))
	return entries
